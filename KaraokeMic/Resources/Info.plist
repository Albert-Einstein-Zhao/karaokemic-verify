<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>K歌麦</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.xuebao.karamic</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>KaraokeMic</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- ══════════════════════════════════════════════════════════════
	     权限声明 —— 三个都很关键，缺一个就白搭
	     ══════════════════════════════════════════════════════════════ -->

	<!-- ① 麦克风权限。缺失则采集不到任何声音 -->
	<key>NSMicrophoneUsageDescription</key>
	<string>需要使用麦克风来采集你的歌声，并通过家庭局域网发送到电视盒子播放。</string>

	<!-- ② ★★★ 本地网络权限 ★★★
	     iOS 14+ 强制要求。不申请的话，所有到局域网的连接都会
	     静默失败（不报错，就是连不上）—— 这是最容易踩的坑 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>需要访问本地网络，才能在你的家庭 Wi-Fi 中找到并连接到电视盒子。</string>

	<!-- ③ mDNS 服务声明（配合 Bonjour 设备发现） -->
	<key>NSBonjourServices</key>
	<array>
		<string>_karamic._udp</string>
	</array>

	<!-- 允许在后台继续收音（唱歌时锁屏） -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- 强制竖屏（手机是手持麦克风，横屏没意义） -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<!-- 麦克风输入需要这个（AVAudioSession 相关） -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
</dict>
</plist>
